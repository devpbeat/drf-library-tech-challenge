# =============================================================================
# Environment Variables for Library API
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_HOST=db
DATABASE_PORT=5432

# -----------------------------------------------------------------------------
# Django Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a new SECRET_KEY for production!
#
# Option 1: Using Python
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Option 2: Using Python (without Django installed)
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# Option 3: Using Bash/OpenSSL
#   openssl rand -base64 50 | tr -d '\n'
#
# Option 4: Using /dev/urandom
#   head -c 50 /dev/urandom | base64 | tr -d '\n'
#
SECRET_KEY=your_secret_key_here
DEBUG=False
